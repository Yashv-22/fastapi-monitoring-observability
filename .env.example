# FastAPI Monitoring Environment Variables Template
# Copy to .env for local overrides (never commit .env)

# Application Configuration
SERVICE_NAME=fastapi-monitoring-demo
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Authentication Demo (Change in production)
DEMO_API_KEY=demo-secret-key-change-me

# Simulation Tuning
SIMULATED_DELAY_SECONDS=5.0
HEALTH_STATE=healthy

# Grafana credentials are required by Compose. Choose them locally; do not
# commit .env or copy these blank placeholders unchanged.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Optional Slack incoming webhook. The preparation script stores this in an
# ignored file consumed by Alertmanager through a Compose secret mount.
SLACK_WEBHOOK_URL=

